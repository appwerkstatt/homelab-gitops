# Vorlage — kopieren nach secrets.env (lokal/Arcane) bzw. mit SOPS verschlüsseln.
# KEINE echten Werte hier eintragen. Echte Secrets aus 1Password / altem System.
#
# ABGLEICH mit der alten .env (aus der Inventur): die DB-Passwörter und API-Keys deiner
# bisherigen Stacks liegen in den alten compose-/.env-Dateien
#   /mnt/fast/docker.OLD/compose/{Identity,Documents,Observability,...}.env  und  compose/.env
# Diese Werte hierher übernehmen (NICHT die alten Dateien committen!). Neu zu erzeugen:
#   OAUTH2_PROXY_COOKIE_SECRET  ->  openssl rand -base64 32
#   die Keycloak-Client-Secrets (grafana/forgejo/netboot/oauth2-proxy) nach Realm-Import in Keycloak generieren.

# --- global ---
LAB_DOMAIN=lab.appsfab.org
ACME_EMAIL=admin@appsfab.org
CF_DNS_API_TOKEN=                 # Cloudflare-Token für DNS-01 (Traefik)
TZ=Europe/Berlin
PUID=568
PGID=568

# --- Keycloak (02) ---
KC_DB_USER=keycloak
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Paperless (11) ---
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_AI_API_KEY=             # Token für das LLM-Gateway (Ollama/Traefik)

# --- Cloudflared (12) ---
# Tunnel-Credentials liegen als Datei: fast/appdata/cloudflared/credentials.json
CF_TUNNEL_TOKEN=

# --- Grafana (20) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_OIDC_CLIENT_SECRET=       # Keycloak-Client-Secret

# --- MinIO (21) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Harbor (22) ---
HARBOR_ADMIN_PASSWORD=
HARBOR_DB_PASSWORD=

# --- oauth2-proxy (03, ForwardAuth) ---
OAUTH2_PROXY_CLIENT_SECRET=        # = Keycloak-Client-Secret "oauth2-proxy"
OAUTH2_PROXY_COOKIE_SECRET=        # openssl rand -base64 32

# --- Keycloak-Client-Secrets (nach Realm-Import in Keycloak generieren) ---
KC_CLIENT_SECRET_GRAFANA=
KC_CLIENT_SECRET_FORGEJO=
KC_CLIENT_SECRET_NETBOOT=

# --- Homepage (40) --- (keine Secrets; Config liegt in stacks/40-homepage/config/)

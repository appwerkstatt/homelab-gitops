# .env.example — VOLLSTÄNDIGE Liste aller Variablen, die die Stacks per ${VAR} lesen.
#
# QUELLE DER WAHRHEIT FÜR SECRETS: 1Password, Vault "AppsFab".
# Diese Datei enthält KEINE Werte, nur 1Password-Referenzen (op://<vault>/<item>/<feld>)
# bzw. unkritische Klartext-Konfiguration. Sie darf (und muss) ins Repo.
#
# Rendern für einen Stack (braucht `op` CLI, angemeldet):
#   scripts/render-env.sh keycloak          # -> nur die Vars, die stacks/*-keycloak/compose.yaml nutzt
#   scripts/render-env.sh --all             # -> alle Vars
# Ausgabe in Arcane -> <Stack> -> Environment einfügen. Gerenderte Datei NIE committen
# (`secrets.env` / `*.env` sind in .gitignore).
#
# Neue Variable in einem compose.yaml? -> hier eintragen + Item/Feld in 1Password anlegen.
# CI (`validate`) schlägt fehl, wenn ein compose ${VAR} nutzt, das hier fehlt.
#
# Item-Konvention: ein Item pro Stack/Dienst ("homelab-<dienst>"), Feldnamen wie unten.
# Die Cluster-Items (argocd-oidc, grafana-oidc, oauth2-proxy-k8s) sind clusterseitig kanonisch
# und werden hier nur referenziert.

# --- global (kein Secret) ---
LAB_DOMAIN=lab.appsfab.org
ACME_EMAIL=admin@appsfab.org
TZ=Europe/Berlin
PUID=568
PGID=568

# --- Traefik (00) ---
CF_DNS_API_TOKEN=op://AppsFab/homelab-traefik/cf-dns-api-token        # Cloudflare-Token für DNS-01

# --- Keycloak (02) ---
KC_DB_USER=keycloak
KC_DB_PASSWORD=op://AppsFab/homelab-keycloak/db-password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=op://AppsFab/homelab-keycloak/bootstrap-admin-password
KCC_CLIENT_SECRET=op://AppsFab/homelab-keycloak/kcc-client-secret     # master-realm Service-Account keycloak-config-cli (RECONCILE.md)
# OIDC-Client-Secrets — EINE Quelle für BEIDE Seiten: den Realm (kcc substituiert $(env:...))
# UND den jeweiligen Consumer-Stack. Fehlt eins in der keycloak-Env, setzt kcc es auf leer!
GRAFANA_OIDC_CLIENT_SECRET=op://AppsFab/homelab-grafana/oidc-client-secret       # + Stack 20-observability
FORGEJO_OIDC_CLIENT_SECRET=op://AppsFab/homelab-forgejo/oidc-client-secret       # Forgejo liest es NICHT aus Env (gitea.db, `forgejo admin auth`)
NETBOOT_OIDC_CLIENT_SECRET=op://AppsFab/homelab-netboot/oidc-client-secret       # + Stack 30-netboot
OAUTH2_PROXY_CLIENT_SECRET=op://AppsFab/homelab-oauth2-proxy/client-secret       # + Stack 03-oauth2-proxy
ZOT_OIDC_CLIENT_SECRET=op://AppsFab/homelab-zot/oidc-client-secret               # + Stack 22-harbor
# Cluster (M4a) — Items clusterseitig kanonisch:
ARGOCD_OIDC_CLIENT_SECRET=op://AppsFab/argocd-oidc/clientSecret
GRAFANA_K8S_OIDC_CLIENT_SECRET=op://AppsFab/grafana-oidc/client_secret
OAUTH2_PROXY_K8S_OIDC_CLIENT_SECRET=op://AppsFab/oauth2-proxy-k8s/client-secret
OAUTH2_PROXY_DEMO_K8S_OIDC_CLIENT_SECRET=op://AppsFab/oauth2-proxy-demo-k8s/client-secret

# --- oauth2-proxy (03) ---
OAUTH2_PROXY_COOKIE_SECRET=op://AppsFab/homelab-oauth2-proxy/cookie-secret       # openssl rand -base64 32

# --- Paperless (11) ---
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=op://AppsFab/homelab-paperless/db-password
PAPERLESS_SECRET_KEY=op://AppsFab/homelab-paperless/secret-key
PAPERLESS_AI_API_KEY=op://AppsFab/homelab-paperless/ai-api-token      # Paperless-API-Token für paperless-ai

# --- n8n (13) ---
N8N_DB_USER=n8n
N8N_DB_PASSWORD=op://AppsFab/homelab-n8n/db-password                  # openssl rand -base64 32
N8N_ENCRYPTION_KEY=op://AppsFab/homelab-n8n/encryption-key            # openssl rand -hex 32; verschlüsselt alle n8n-Credentials, NIE neu erzeugen

# --- Grafana (20) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=op://AppsFab/homelab-grafana/admin-password

# --- Alerting (20, Alertmanager -> Telegram) ---
# Bot via @BotFather anlegen; Chat-ID: Bot anschreiben, dann https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=op://AppsFab/homelab-alerting/telegram-bot-token
TELEGRAM_CHAT_ID=op://AppsFab/homelab-alerting/telegram-chat-id      # Zahl, bei Gruppen negativ

# --- Garage S3 (21) ---  (Bucket-Keys entstehen per `garage key create`; ebenfalls in 1Password ablegen)
GARAGE_RPC_SECRET=op://AppsFab/homelab-garage/rpc-secret              # openssl rand -hex 32 (genau 64 Hex-Zeichen)
GARAGE_ADMIN_TOKEN=op://AppsFab/homelab-garage/admin-token            # openssl rand -base64 32
GARAGE_METRICS_TOKEN=op://AppsFab/homelab-garage/metrics-token        # openssl rand -base64 32

# --- Registry-Cache (23) ---
# Wer mirror.lab nutzen darf (Traefik ipallowlist, kommagetrennt, kein Secret).
# VLANs Kubernetes (80) + Trusted (10, u. a. Mac/OrbStack). Andere VLANs/Gäste -> 403.
MIRROR_ALLOWED_CIDRS=192.168.80.0/24,192.168.10.0/24
DOCKERHUB_USERNAME=op://AppsFab/homelab-dockerhub/username
DOCKERHUB_TOKEN=op://AppsFab/homelab-dockerhub/access-token           # Docker-Hub Access-Token (read-only)

# --- Netboot-Console (30) ---
# Forgejo-PAT: scopes read:user, write:repository (christian/cluster).
FORGEJO_TOKEN=op://AppsFab/homelab-netboot/forgejo-token
# Feature-Flags (kein Secret). 0 = aus; auf 1 setzen + Arcane Recreate aktiviert das Feature.
CONSOLE_SNAPSHOT_ENABLED=0     # etcd-Snapshot-Verb
CONSOLE_ETCD_HEALTH_ENABLED=0  # etcd MEMBER-Health-Prober
CONSOLE_HW_HEALTH_ENABLED=0    # Pi-Hardware-Signale

# --- Datei-Secrets (keine Env-Vars; liegen auf dem NAS, Original als 1Password-Dokument) ---
# Wiederherstellen mit: op document get "<name>" --vault AppsFab --out-file <pfad>  (danach chmod 600)
#   homelab-cloudflared-credentials.json -> /mnt/fast/appdata/cloudflared/credentials.json
#   homelab-zot-htpasswd                 -> /mnt/fast/appdata/registry/htpasswd
#   homelab-netboot-wipe-ssh.key         -> /mnt/fast/appdata/netboot-console/wipe-ssh.key
#   homelab-forgejo-jwt-private.pem      -> /mnt/fast/appdata/forgejo/jwt/private.pem
#   homelab-restic-b2.env                -> /mnt/fast/appdata/_secrets/restic-b2.env  (s. docs/nas-backup)

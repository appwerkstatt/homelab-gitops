{
  "realm": "AppsFab",
  "attributes": {
    "frontendUrl": "https://auth.appsfab.org"
  },
  "enabled": true,
  "displayName": "AppsFab Homelab",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "sslRequired": "external",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined)",

  "browserFlow": "browser-passkey",
  "directGrantFlow": "direct-grant-disabled",

  "eventsListeners": ["jboss-logging"],

  "webAuthnPolicyPasswordlessRpEntityName": "AppsFab Homelab",
  "webAuthnPolicyPasswordlessRpId": "appsfab.org",
  "webAuthnPolicyRpId": "appsfab.org",
  "webAuthnPolicyRpEntityName": "AppsFab Homelab",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "not specified",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "preferred",
  "webAuthnPolicyPasswordlessCreateTimeout": 0,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyPasswordlessAcceptableAaguids": [],
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,

  "roles": {
    "realm": [
      { "name": "lab-admin", "description": "Voller Zugriff auf Lab-Dienste" },
      { "name": "lab-user", "description": "Standard-Zugriff" }
    ]
  },
  "groups": [
    { "name": "lab-admins", "realmRoles": ["lab-admin"] },
    { "name": "lab-users", "realmRoles": ["lab-user"] },
    { "name": "family" },
    { "name": "devs" },
    { "name": "demo-viewers" }
  ],

  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 10, "config": {} },
    { "alias": "TERMS_AND_CONDITIONS", "name": "Terms and Conditions", "providerId": "TERMS_AND_CONDITIONS", "enabled": false, "defaultAction": false, "priority": 20, "config": {} },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30, "config": {} },
    { "alias": "UPDATE_PROFILE", "name": "Update Profile", "providerId": "UPDATE_PROFILE", "enabled": true, "defaultAction": false, "priority": 40, "config": {} },
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": true, "defaultAction": false, "priority": 50, "config": {} },
    { "alias": "delete_account", "name": "Delete Account", "providerId": "delete_account", "enabled": false, "defaultAction": false, "priority": 60, "config": {} },
    { "alias": "webauthn-register", "name": "Webauthn Register", "providerId": "webauthn-register", "enabled": true, "defaultAction": false, "priority": 70, "config": {} },
    { "alias": "webauthn-register-passwordless", "name": "Webauthn Register Passwordless", "providerId": "webauthn-register-passwordless", "enabled": true, "defaultAction": false, "priority": 80, "config": {} },
    { "alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": true, "defaultAction": false, "priority": 90, "config": {} },
    { "alias": "delete_credential", "name": "Delete Credential", "providerId": "delete_credential", "enabled": true, "defaultAction": false, "priority": 100, "config": {} },
    { "alias": "CONFIGURE_RECOVERY_AUTHN_CODES", "name": "Recovery Authentication Codes", "providerId": "CONFIGURE_RECOVERY_AUTHN_CODES", "enabled": true, "defaultAction": false, "priority": 110, "config": {} },
    { "alias": "idp_link", "name": "Linking Identity Provider", "providerId": "idp_link", "enabled": true, "defaultAction": false, "priority": 120, "config": {} },
    { "alias": "update_user_locale", "name": "Update User Locale", "providerId": "update_user_locale", "enabled": true, "defaultAction": false, "priority": 1000, "config": {} }
  ],

  "authenticationFlows": [
    {
      "alias": "browser-passkey",
      "description": "Browser-Flow: Passkey allein oder Passwort + zweiter Faktor (Details: PASSKEYS.md)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "identity-provider-redirector", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "browser-passkey-forms", "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-passkey-forms",
      "description": "Username-Form mit Passkey-Autofill; ohne Passkey weiter mit Passwort + zweitem Faktor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "browser-passkey-password-2fa", "requirement": "CONDITIONAL", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-passkey-password-2fa",
      "description": "Nur wenn kein Passkey benutzt wurde: Passwort, danach Pflicht-2FA; ohne zweiten Faktor muss beim Login ein Passkey eingerichtet werden",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-credential", "authenticatorConfig": "no-passkey-used", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 5, "userSetupAllowed": false },
        { "authenticator": "auth-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "browser-passkey-second-factor", "requirement": "CONDITIONAL", "priority": 20, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "browser-passkey-enroll", "requirement": "CONDITIONAL", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-passkey-second-factor",
      "description": "Zweiter Faktor (falls eingerichtet): Passkey, Sicherheitsschlüssel, OTP-App oder Recovery-Code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "webauthn-authenticator-passwordless", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "webauthn-authenticator", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 40, "userSetupAllowed": false },
        { "authenticator": "auth-recovery-authn-code-form", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 50, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-passkey-enroll",
      "description": "Noch kein zweiter Faktor: Passkey/Sicherheitsschlüssel jetzt einrichten (Required Action webauthn-register), sonst kein Login",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-sub-flow-executed", "authenticatorConfig": "second-factor-not-executed", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "webauthn-authenticator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": true }
      ]
    },
    {
      "alias": "direct-grant-disabled",
      "description": "Password-Grant (ROPC) für alle Clients aus: er würde Passkey/2FA umgehen. Kein Dienst nutzt ihn.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "deny-access-authenticator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false }
      ]
    }
  ],

  "authenticatorConfig": [
    {
      "alias": "no-passkey-used",
      "config": { "credentials": "webauthn-passwordless", "included": "false" }
    },
    {
      "alias": "second-factor-not-executed",
      "config": { "flow_to_check": "browser-passkey-second-factor", "check_result": "not-executed" }
    }
  ],

  "clients": [
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:GRAFANA_OIDC_CLIENT_SECRET)",
      "redirectUris": ["https://grafana.lab.appsfab.org/login/generic_oauth"],
      "webOrigins": ["https://grafana.lab.appsfab.org"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "forgejo",
      "name": "Forgejo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:FORGEJO_OIDC_CLIENT_SECRET)",
      "redirectUris": ["https://git.appsfab.org/user/oauth2/keycloak/callback"],
      "webOrigins": ["https://git.appsfab.org"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "netboot-console",
      "name": "Netboot-Konsole",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:NETBOOT_OIDC_CLIENT_SECRET)",
      "redirectUris": ["https://netboot.lab.appsfab.org/auth/callback"],
      "webOrigins": ["https://netboot.lab.appsfab.org"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "zot",
      "name": "Zot Registry",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "secret": "$(env:ZOT_OIDC_CLIENT_SECRET)",
      "redirectUris": ["https://registry.lab.appsfab.org/zot/auth/callback/oidc"],
      "webOrigins": ["https://registry.lab.appsfab.org"],
      "attributes": {
        "post.logout.redirect.uris": "https://registry.lab.appsfab.org/login"
      },
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "oauth2-proxy",
      "name": "Traefik ForwardAuth (oauth2-proxy)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:OAUTH2_PROXY_CLIENT_SECRET)",
      "redirectUris": [
        "https://traefik.lab.appsfab.org/oauth2/callback",
        "https://docs-ai.lab.appsfab.org/oauth2/callback",
        "https://home.lab.appsfab.org/oauth2/callback",
        "https://admin.lab.appsfab.org/oauth2/callback",
        "https://n8n.lab.appsfab.org/oauth2/callback",
        "https://plane.lab.appsfab.org/oauth2/callback",
        "https://doku.lab.appsfab.org/oauth2/callback"
      ],
      "webOrigins": [
        "https://traefik.lab.appsfab.org",
        "https://docs-ai.lab.appsfab.org",
        "https://home.lab.appsfab.org",
        "https://admin.lab.appsfab.org",
        "https://n8n.lab.appsfab.org",
        "https://plane.lab.appsfab.org",
        "https://doku.lab.appsfab.org"
      ],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "argocd-k8s",
      "name": "ArgoCD (cluster)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:ARGOCD_OIDC_CLIENT_SECRET)",
      "redirectUris": [
        "https://argocd.k8s.appsfab.org/auth/callback",
        "http://localhost:8085/auth/callback"
      ],
      "webOrigins": ["https://argocd.k8s.appsfab.org"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "grafana-k8s",
      "name": "Grafana (cluster)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:GRAFANA_K8S_OIDC_CLIENT_SECRET)",
      "redirectUris": ["https://grafana.k8s.appsfab.org/login/generic_oauth"],
      "webOrigins": ["https://grafana.k8s.appsfab.org"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "oauth2-proxy-k8s",
      "name": "oauth2-proxy (cluster ForwardAuth)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:OAUTH2_PROXY_K8S_OIDC_CLIENT_SECRET)",
      "redirectUris": [
        "https://longhorn.k8s.appsfab.org/oauth2/callback",
        "https://lab-status.k8s.appsfab.org/oauth2/callback"
      ],
      "webOrigins": [
        "https://longhorn.k8s.appsfab.org",
        "https://lab-status.k8s.appsfab.org"
      ],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "oauth2-proxy-demo-k8s",
      "name": "oauth2-proxy (cluster demo apps)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "$(env:OAUTH2_PROXY_DEMO_K8S_OIDC_CLIENT_SECRET)",
      "redirectUris": ["https://auth.demo.k8s.appsfab.org/oauth2/callback"],
      "webOrigins": ["https://auth.demo.k8s.appsfab.org"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}

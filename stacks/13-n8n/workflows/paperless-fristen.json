      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.paperlessUrl }}/api/custom_fields/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "page_size",
              "value": "100"
            }
          ]

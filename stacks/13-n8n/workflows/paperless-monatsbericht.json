      "id": "b3000000-0000-4000-8000-000000000009",
      "name": "Steuer ohne Jahr",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Paperless lesen"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst F = $('Abfragen').first().json.F;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst val = (d, name) => (d.custom_fields || []).find(c => c.field === F[name])?.value ?? null;\nconst euro = v => v ? parseFloat(String(v).replace(/^[A-Z]{3}/, '')) || 0 : 0;   // Paperless: \"EUR49.90\"\nconst fmtEuro = n => n.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });\nconst fmtDate = d => d ? d.split('-').reverse().join('.') : '–';\nconst link = d => `<a href=\"${cfg.paperlessUrl}/documents/${d.id}/details\">${esc(d.title)}</a>`;\nconst a = $('Abfragen').first().json;\nconst res = n => $(n).first().json;\nconst rech = res('Rechnungen Vormonat').results || [];\nconst offen = res('Offene Rechnungen').results || [];\nconst fristen = res('Verträge 90 Tage').results || [];\nconst sum = docs => docs.reduce((s, d) => s + euro(val(d, 'Betrag')), 0);\n\nconst lines = [`📊 <b>Paperless: ${esc(a.monat)}</b>`, ''];\nlines.push(`🧾 Rechnungen im ${esc(a.monat.split(' ')[0])}: <b>${rech.length}</b>, zusammen <b>${fmtEuro(sum(rech))}</b>`);\nconst top = [...rech].sort((x, y) => euro(val(y, 'Betrag')) - euro(val(x, 'Betrag'))).slice(0, 5);\nfor (const d of top) lines.push(`  • ${link(d)} · ${fmtEuro(euro(val(d, 'Betrag')))}`);\nlines.push('', `⏳ Offen (nicht bezahlt): <b>${offen.length}</b>, zusammen <b>${fmtEuro(sum(offen))}</b>`);\nconst overdue = offen.filter(d => val(d, 'Fällig am') && val(d, 'Fällig am') < a.today);\nif (overdue.length) lines.push(`  🔴 davon überfällig: ${overdue.length}`);\nlines.push('', `📝 Vertragsfristen in 90 Tagen: <b>${fristen.length}</b>`);\nfor (const d of fristen.slice(0, 10)) {\n  const k = val(d, 'Kündigen bis'), e = val(d, 'Vertragsende');\n  lines.push(`  • ${link(d)}: ${k ? 'kündigen bis ' + fmtDate(k) : 'endet ' + fmtDate(e)}`);\n}\nlines.push('', `🏛️ Steuer ${a.steuerjahr}: <b>${res('Steuer Vorjahr').count ?? 0}</b> Dokumente` +\n  (res('Steuer ohne Jahr').count ? `, ⚠️ ${res('Steuer ohne Jahr').count} ohne Steuerjahr` : ''));\nlines.push(`<a href=\"${cfg.paperlessUrl}/dashboard\">Paperless öffnen</a>`);\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },

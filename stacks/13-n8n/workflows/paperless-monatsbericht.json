      "id": "b3000000-0000-4000-8000-000000000003",
      "name": "Felder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Paperless lesen"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst F = Object.fromEntries(($('Felder').first().json.results || []).map(f => [f.name, f.id]));\nfor (const n of ['Betrag', 'Fällig am', 'Bezahlt', 'Vertragsende', 'Kündigen bis', 'Steuerjahr']) {\n  if (!F[n]) throw new Error(`Custom Field \"${n}\" fehlt in Paperless (paperless-setup.py laufen lassen)`);\n}\n// Datum in Europe/Berlin als YYYY-MM-DD, plus n Tage\nconst today = new Date().toLocaleDateString('sv-SE', { timeZone: cfg.timezone });\nconst plus = (d, n) => new Date(Date.parse(d + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);\nconst q = x => JSON.stringify(x);\n\n// Vormonat [von, bis) und Steuerjahr = Vorjahr. Abfragen wie scripts/check-paperless-setup.py (queries).\nconst [y, m] = today.split('-').map(Number);\nconst bis = `${y}-${String(m).padStart(2, '0')}-01`;\nconst von = m === 1 ? `${y - 1}-12-01` : `${y}-${String(m - 1).padStart(2, '0')}-01`;\nconst monat = new Date(von + 'T12:00:00Z').toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });\nreturn [{ json: { F, today, von, bis, monat, steuerjahr: y - 1,\n  rechnungen: q([F['Betrag'], 'exists', true]),\n  offen: q(['AND', [[F['Betrag'], 'exists', true], ['NOT', [F['Bezahlt'], 'exact', true]]]]),\n  fristen: q(['OR', [[F['Kündigen bis'], 'range', [today, plus(today, 90)]], [F['Vertragsende'], 'range', [today, plus(today, 90)]]]]),\n  steuer: q([F['Steuerjahr'], 'exact', y - 1]),\n  steuerOhneJahr: q(['AND', [[F['Steuerjahr'], 'exists', true], [F['Steuerjahr'], 'isnull', true]]]),\n} }];\n"
      },

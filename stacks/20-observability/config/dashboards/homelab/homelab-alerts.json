    {
      "id": 9,
      "type": "table",
      "title": "Aktive Alerts",
      "description": "Aktuell feuernde Alerts aus vmalert. Zugestellt per Telegram (Alertmanager).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "noValue": "Keine aktiven Alerts 🎉"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Schwere"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Schwere",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true,
              "integration": true,
              "alertgroup": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "instance": 2,
              "name": 3
            },
            "renameByName": {
              "severity": "Schwere",
              "alertname": "Alert",
              "instance": "Instanz",
              "name": "Container"
            }
          }
        }
      ]
    },

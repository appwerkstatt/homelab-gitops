        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (alertname, severity, instance, name, mountpoint, zpool) (ALERTS{alertstate=\"firing\"})",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{alertname}} {{instance}}{{name}}{{mountpoint}}{{zpool}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "firing",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "1m"
    },

      {
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": false,
        "iconColor": "red",
        "name": "Alerts (firing)",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{instance}}{{name}}{{mountpoint}}{{zpool}}",

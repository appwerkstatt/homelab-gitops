    {
      "id": 14,
      "type": "bargauge",
      "title": "ZFS-Pools belegt",
      "description": "Alert ab 85 % (PoolSpaceLow) bzw. 95 % (PoolSpaceCritical).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - node_filesystem_avail_bytes{fstype=\"zfs\",mountpoint=~\"/mnt/[^/]+\"} / node_filesystem_size_bytes{fstype=\"zfs\",mountpoint=~\"/mnt/[^/]+\"}",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{mountpoint}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          },
          "min": 0,
          "max": 1
        },

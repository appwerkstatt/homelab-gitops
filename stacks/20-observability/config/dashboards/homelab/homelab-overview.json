            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "smooth",
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {

          },
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "refId": "B",
          "editorMode": "code",
          "legendFormat": "RAM",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "node_load5 / scalar(count(node_cpu_seconds_total{mode=\"idle\"}))",
          "refId": "C",

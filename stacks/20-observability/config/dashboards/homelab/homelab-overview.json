    {
      "id": 10,
      "type": "stat",
      "title": "Dienst-Status",
      "description": "Blackbox-Probe je Dienst (intern über die edge-Netze). Details im Dashboard »Dienste«.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(probe_success{job=~\"probe-http|probe-registry|probe-paperless|probe-llm\"}, \"svc\", \"$1\", \"instance\", \"(?:https?://)?([^:/]+).*\"), \"svc\", \"ollama (Mac Studio)\", \"instance\", \".*:11434/.*\"), \"svc\", \"lm-studio (Mac Studio)\", \"instance\", \".*:1234/.*\"), \"svc\", \"zot\", \"instance\", \"http://zot:.*\"), \"svc\", \"registry-cache\", \"instance\", \"http://dockerhub:.*\"), \"svc\", \"TLS-Wildcard\", \"instance\", \"auth\\\\.lab\\\\..*:443\")",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{svc}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "links": [
            {
              "title": "Dienste & Erreichbarkeit",
              "url": "/d/homelab-services?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Aktive Alerts",
      "description": "Aktuell feuernde Alerts aus vmalert. Zugestellt per Telegram (Alertmanager).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "noValue": "Keine aktiven Alerts 🎉"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Schwere"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Schwere",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true,
              "integration": true,
              "alertgroup": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "instance": 2,
              "name": 3
            },
            "renameByName": {
              "severity": "Schwere",
              "alertname": "Alert",
              "instance": "Instanz",
              "name": "Container"
            }
          }
        }
      ]
    },

          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(avg_over_time(probe_success{job=~\"probe-http|probe-registry|probe-paperless|probe-llm\"}[$__range]), \"svc\", \"$1\", \"instance\", \"(?:https?://)?([^:/]+).*\"), \"svc\", \"ollama (Mac Studio)\", \"instance\", \".*:11434/.*\"), \"svc\", \"lm-studio (Mac Studio)\", \"instance\", \".*:1234/.*\"), \"svc\", \"zot\", \"instance\", \"http://zot:.*\"), \"svc\", \"registry-cache\", \"instance\", \"http://dockerhub:.*\"), \"svc\", \"TLS-Wildcard\", \"instance\", \"auth\\\\.lab\\\\..*:443\")",

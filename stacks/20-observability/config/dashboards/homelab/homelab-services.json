    "homelab",
    "services"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "weekStart": "monday",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Homelab",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": false,
        "iconColor": "red",
        "name": "Alerts (firing)",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{instance}}{{name}}{{mountpoint}}{{zpool}}",
        "useValueForTime": false,
        "hide": false
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dienst-Status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(probe_success{job=~\"probe-http|probe-registry|probe-paperless|probe-llm\"}, \"svc\", \"$1\", \"instance\", \"(?:https?://)?([^:/]+).*\"), \"svc\", \"ollama (Mac Studio)\", \"instance\", \".*:11434/.*\"), \"svc\", \"lm-studio (Mac Studio)\", \"instance\", \".*:1234/.*\"), \"svc\", \"zot\", \"instance\", \"http://zot:.*\"), \"svc\", \"registry-cache\", \"instance\", \"http://dockerhub:.*\"), \"svc\", \"TLS-Wildcard\", \"instance\", \"auth\\\\.lab\\\\..*:443\")",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{svc}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
